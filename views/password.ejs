<%- include("partials/head") %>
<%- include("partials/nav") %>

<div class="page page-narrow">
  <section class="panel auth-panel">
    <h1 class="panel-title">Change password</h1>
    <form method="post" action="/password" class="stack-form">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <label for="pw-current">Current password</label>
      <input type="password" id="pw-current" name="currentPassword" required autocomplete="current-password">
      <label for="pw-new">New password <span class="muted">(min 8 characters)</span></label>
      <input type="password" id="pw-new" name="newPassword" minlength="8" maxlength="200" required autocomplete="new-password">
      <button type="submit" class="btn btn-primary btn-block">Update password</button>
    </form>
  </section>
</div>

<%- include("partials/foot") %>