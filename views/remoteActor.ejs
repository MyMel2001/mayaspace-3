<%- include("partials/head") %>
<%- include("partials/nav") %>

<div class="page">
  <div class="page-main">
    <section class="panel profile-hero">
      <div class="profile-hero-main">
        <div class="profile-avatar">
          <% if (actor.avatarUrl) { %><img src="<%= actor.avatarUrl %>" alt="" width="96" height="96"><% } else { %><span class="avatar-fallback avatar-lg"><%= actor.name.slice(0, 1).toUpperCase() %></span><% } %>
        </div>
        <div class="profile-id">
          <h1 class="profile-name"><%= actor.name %> <span class="badge badge-remote">fediverse</span></h1>
          <p class="profile-handle">@<%= actor.handle %></p>
          <% if (actor.bioHtml) { %><div class="profile-bio"><%- actor.bioHtml %></div><% } %>
          <% if (actor.url) { %><p><a href="<%= actor.url %>" target="_blank" rel="noopener noreferrer">View on their server ↗</a></p><% } %>
        </div>
      </div>
      <div class="profile-actions">
        <% if (user) { %>
          <% if (actor.suspended) { %>
            <span class="btn btn-disabled">Blocked on this server</span>
          <% } else if (following) { %>
            <form method="post" action="/fediverse/unfollow" class="inline-form">
              <input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="actorId" value="<%= actor.actorId %>">
              <button type="submit" class="btn">✓ Following — unfollow?</button>
            </form>
          <% } else { %>
            <form method="post" action="/fediverse/follow" class="inline-form">
              <input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="actor" value="<%= actor.actorId %>">
              <button type="submit" class="btn btn-primary">+ Follow</button>
            </form>
          <% } %>
        <% } else { %>
          <a href="/login" class="btn">Log in to follow</a>
        <% } %>
      </div>
    </section>

    <section class="profile-posts">
      <h2 class="panel-title">Posts mirrored here</h2>
      <% if (posts.length === 0) { %><div class="empty-state"><p>No posts mirrored yet. Once you follow them, new posts will appear here.</p></div><% } %>
      <% for (const post of posts) { %>
        <%- include("partials/post", { post }) %>
      <% } %>
    </section>
  </div>
</div>

<%- include("partials/foot") %>