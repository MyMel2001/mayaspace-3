<%- include("partials/head") %>
<%- include("partials/nav") %>

<div class="page">
  <div class="page-main">
    <% if (typeof user !== "undefined" && user) { %>
      <section class="panel" id="follow-requests">
        <div class="panel-title-row">
          <h1 class="panel-title">Follow requests
            <% if (followRequests.length > 0) { %><span class="badge badge-alert"><%= followRequests.length %></span><% } %>
          </h1>
          <% if (followRequests.length > 0) { %>
            <a href="/fediverse/follow-requests" class="btn">Manage all</a>
          <% } %>
        </div>
        <% if (followRequests.length === 0) { %>
          <p class="muted">No pending fediverse follow requests.</p>
        <% } %>
        <% for (const r of followRequests) { %>
          <div class="friend-row">
            <a href="/fediverse/actor?actor=<%= encodeURIComponent(r.actorId) %>" class="friend-name">
              <% if (r.avatarUrl) { %><img src="<%= r.avatarUrl %>" alt="" width="32" height="32" loading="lazy"><% } %>
              <%= r.name %>
            </a>
            <span class="badge badge-remote">fediverse</span>
            <span class="muted">@<%= r.handle %></span>
            <form method="post" action="/fediverse/follow-requests/accept" class="inline-form">
              <input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="actorId" value="<%= r.actorId %>">
              <button type="submit" class="btn btn-primary">Accept</button>
            </form>
            <form method="post" action="/fediverse/follow-requests/reject" class="inline-form">
              <input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="actorId" value="<%= r.actorId %>">
              <button type="submit" class="btn">Decline</button>
            </form>
          </div>
        <% } %>
      </section>
    <% } %>

    <section class="panel">
      <h1 class="panel-title">🌐 Fediverse lookup</h1>
      <p class="muted">Enter a handle (<code>user@server</code>) or an actor URL to view their profile from here.</p>
      <form method="get" action="/fediverse/actor" class="row-form">
        <input type="text" name="actor" placeholder="someone@example.com" required class="grow">
        <button type="submit" class="btn btn-primary">Look up</button>
      </form>
    </section>

    <section class="feed">
      <h2 class="panel-title">Mirrored remote posts</h2>
      <% if (posts.length === 0) { %><div class="empty-state"><p>Nothing from the fediverse yet. Follow someone above!</p></div><% } %>
      <% for (const post of posts) { %>
        <%- include("partials/post", { post }) %>
      <% } %>
    </section>
  </div>

  <aside class="page-side">
    <div class="panel">
      <h2 class="panel-title">Known fediverse accounts</h2>
      <% if (remoteActors.length === 0) { %><p class="muted">None discovered yet.</p><% } %>
      <ul class="actor-list">
        <% for (const a of remoteActors) { %>
          <li>
            <a href="/fediverse/actor?actor=<%= encodeURIComponent(a.actorId) %>">
              <% if (a.avatarUrl) { %><img src="<%= a.avatarUrl %>" alt="" width="24" height="24"><% } %>
              <%= a.name %>
            </a>
            <% if (a.suspended) { %><span class="badge badge-danger">blocked</span><% } %>
          </li>
        <% } %>
      </ul>
    </div>
  </aside>
</div>

<%- include("partials/foot") %>