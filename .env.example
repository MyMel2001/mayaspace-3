# ──────────────────────────────────────────────────────────────
# MayaSpace configuration (template — copy to ".env" and edit)
# ──────────────────────────────────────────────────────────────

MAYA_URL=https://your-domain.example
PORT=3414
SITE_NAME=MayaSpace
SITE_TAGLINE=A place for friends.

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Handles that become admin / moderator when they register (or next log in).
ADMIN_HANDLES=admin
MODERATOR_HANDLES=mod

DB_PATH=./data/mayaspace.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
ATTACHMENTS_PER_POST=4
POST_MAX_CHARS=10000
COMMENT_MAX_CHARS=3000
COOKIE_SECURE=auto
# Set to 1 behind nginx/Caddy/Cloudflare (i.e. whenever TLS terminates at a
# proxy). 0 is only correct for direct HTTP exposure.
TRUST_PROXY=1
LOG_LEVEL=info